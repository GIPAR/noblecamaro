<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="camaro.gazebo">

  <!-- ========== MATERIAIS ========== -->
  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="front_left_wheel_link">
    <material>Gazebo/Gray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <material>Gazebo/Gray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <material>Gazebo/Gray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <material>Gazebo/Gray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ========== PLUGIN ACKERMANN NATIVO DO GAZEBO HARMONIC ========== -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
      <kingpin_width>0.46</kingpin_width>
      <steering_limit>0.6</steering_limit>
      <wheel_base>0.71</wheel_base>
      <wheel_separation>0.46</wheel_separation>
      <wheel_radius>0.11</wheel_radius>
      <min_velocity>-5</min_velocity>
      <max_velocity>5</max_velocity>
      <min_acceleration>-3</min_acceleration>
      <max_acceleration>3</max_acceleration>
      <!-- Frames corretos para o SLAM Toolbox e NAV2 -->
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ========== PLUGIN JOINT STATE PUBLISHER ========== -->     ← ADICIONA AQUI
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>


  <!-- ========== PLUGIN DO LIDAR (padrão NARA que funciona) ========== -->
  <gazebo reference="lidarA2">
    <sensor type="gpu_lidar" name="lidarA2_sensor">
      <gz_frame_id>lidarA2</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>/lidarA2/scan</topic>
      <update_rate>10</update_rate>
      <enable_metrics>false</enable_metrics>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.30</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ========== SENSOR ZED 2i (RGBD + nuvem de pontos) no zed_mount ========== -->
  <!-- Padrão do driver real (zed_wrapper): /zed/zed_node/rgb/image_raw
       (+ depth_image, points, camera_info). O Gazebo publica ainda
       <topic>/image, <topic>/depth_image e <topic>/points. -->
  <gazebo reference="zed_mount">
    <sensor name="zed2i_rgbd" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/zed/zed_node/rgb/image_raw</topic>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.91986</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ========== SENSOR CÂMERA DO USUÁRIO (2D), virada para trás ========== -->
  <gazebo reference="camera_user_link">
    <sensor name="camera_user" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera_user/image</topic>
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>