<?xml version="1.0"?>
<robot name="smart_camaro" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="camaro.gazebo" />

  <!-- ========== CHASSI PRINCIPAL ========== -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.041666" ixy="0.0" ixz="0.0"
               iyy="0.108333" iyz="0.0"
               izz="0.141666"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/> 
      
      <geometry>
        <mesh filename="package://camaro_description/meshes/camaronovo.glb"
              scale="0.0012 0.0012 0.0012"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/> 
      <geometry>
        <box size="0.6 0.46 0.15"/>
      </geometry>
    </collision>
  </link>


  <!-- ========== DIREÇÃO DIANTEIRA ESQUERDA ========== -->
  <link name="front_left_wheel_steering_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_wheel_steering_link"/>
    <origin xyz="0.375 0.23 0.11" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="25" velocity="1.0"/>
  </joint>

  <!-- ========== DIREÇÃO DIANTEIRA DIREITA ========== -->
  <link name="front_right_wheel_steering_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_wheel_steering_link"/>
    <origin xyz="0.375 -0.23 0.11" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="25" velocity="1.0"/>
  </joint>

  <!-- ========== RODA DIANTEIRA ESQUERDA ========== -->
<link name="front_left_wheel_link">
  <inertial>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="0.0036" ixy="0.0" ixz="0.0" iyy="0.0061" iyz="0.0" izz="0.0036"/>
  </inertial>
  <visual>
    <!-- Roda original (rodanova.glb): diâmetro 0.22m (raio 0.11).
         Eixo da malha é X -> girada para o eixo virar Y (giro -90° p/ esquerda,
         +90° p/ direita). SEM escala negativa (evita mesh transparente). -->
    <origin xyz="0 0.0313 0" rpy="0 0 -1.5707"/>
    <geometry>
      <mesh filename="package://camaro_description/meshes/rodanova.glb"
            scale="0.0008462 0.0008462 0.0008462"/>
    </geometry>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    <geometry><cylinder radius="0.11" length="0.08"/></geometry>
  </collision>
</link>

  <joint name="front_left_wheel_joint" type="revolute">
    <parent link="front_left_wheel_steering_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> 
    <axis xyz="0 1 0"/>
    <limit lower="-1.79769e+308" upper="1.79769e+308" effort="100" velocity="100"/>
  </joint>

  <!-- ========== RODA DIANTEIRA DIREITA ========== -->
<link name="front_right_wheel_link">
  <inertial>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="0.0036" ixy="0.0" ixz="0.0" iyy="0.0061" iyz="0.0" izz="0.0036"/>
  </inertial>
  <visual>
    <!-- Roda DIREITA aponta p/ fora (-Y) — par espelhado da esquerda. -->
    <origin xyz="0 -0.0313 0" rpy="0 0 1.5707"/>
    <geometry>
      <mesh filename="package://camaro_description/meshes/rodanova.glb"
            scale="0.0008462 0.0008462 0.0008462"/>
    </geometry>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    <geometry><cylinder radius="0.11" length="0.08"/></geometry>
  </collision>
</link>

  <joint name="front_right_wheel_joint" type="revolute">
    <parent link="front_right_wheel_steering_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> 
    <axis xyz="0 1 0"/>
    <limit lower="-1.79769e+308" upper="1.79769e+308" effort="100" velocity="100"/>
  </joint>

  <!-- ========== RODA TRASEIRA ESQUERDA ========== -->
<link name="rear_left_wheel_link">
  <inertial>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="0.0036" ixy="0.0" ixz="0.0" iyy="0.0061" iyz="0.0" izz="0.0036"/>
  </inertial>
  <visual>
    <origin xyz="0 0.0313 0" rpy="0 0 -1.5707"/>
    <geometry>
      <mesh filename="package://camaro_description/meshes/rodanova.glb"
            scale="0.0008462 0.0008462 0.0008462"/>
    </geometry>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    <geometry><cylinder radius="0.11" length="0.08"/></geometry>
  </collision>
</link>

  <joint name="rear_left_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.335 0.23 0.11" rpy="0 0 0"/> 
    <axis xyz="0 1 0"/>
    <limit lower="-1.79769e+308" upper="1.79769e+308" effort="100" velocity="100"/>
  </joint>

  <!-- ========== RODA TRASEIRA DIREITA ========== -->
<link name="rear_right_wheel_link">
  <inertial>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="0.0036" ixy="0.0" ixz="0.0" iyy="0.0061" iyz="0.0" izz="0.0036"/>
  </inertial>
  <visual>
    <origin xyz="0 -0.0313 0" rpy="0 0 1.5707"/>
    <geometry>
      <mesh filename="package://camaro_description/meshes/rodanova.glb"
            scale="0.0008462 0.0008462 0.0008462"/>
    </geometry>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    <geometry><cylinder radius="0.11" length="0.08"/></geometry>
  </collision>
</link>

  <joint name="rear_right_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <!-- JUNTA NEUTRA: Sem rpy aqui! -->
    <origin xyz="-0.335 -0.23 0.11" rpy="0 0 0"/> 
    <axis xyz="0 1 0"/>
    <limit lower="-1.79769e+308" upper="1.79769e+308" effort="100" velocity="100"/>
  </joint>

  <!-- ========== SENSOR LIDAR (CORRIGIDO: SEM COLISÃO) ========== -->
  <!-- Link do LiDAR SEM visual por enquanto (sensor continua ativo via camaro.gazebo) -->
  <link name="lidarA2">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="lidar_to_chassi" type="fixed">
    <parent link="base_link"/>
    <child link="lidarA2"/>
    <!-- LiDAR colado na parte de baixo do chassi, na frente, perto das rodas -->
    <origin xyz="0.55 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- ========== ZED 2 (VISUAL BÁSICO: suporte + corpo) ========== -->
  <!-- Visual provisório; depois trocamos pelo mesh real da ZED 2 -->
  <!-- Haste reduzida apoiada no topo do aerofólio -->
  <link name="zed_support">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.30"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.30"/>
      <geometry><box size="0.02 0.02 0.60"/></geometry>
      <material name="preto">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.585"/>
      <geometry><box size="0.06 0.06 0.03"/></geometry>
      <material name="preto">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.30"/>
      <geometry><box size="0.02 0.02 0.60"/></geometry>
    </collision>
  </link>

  <joint name="zed_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_support"/>
    <origin xyz="-0.58 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="zed_mount">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <mass value="0.08"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin rpy="0 0 -1.5708" xyz="0 0 0.0018"/>
      <geometry>
        <mesh filename="package://camaro_description/meshes/zed2_detailed.stl"/>
      </geometry>
      <material name="zed_body">
        <color rgba="0.18 0.18 0.18 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry><box size="0.035 0.18 0.035"/></geometry>
    </collision>
  </link>

  <joint name="zed_mount_joint" type="fixed">
    <parent link="zed_support"/>
    <child link="zed_mount"/>
    <origin xyz="0 0 0.60" rpy="0 0 0"/>
  </joint>

  <!-- Câmera do usuário (2D), virada para trás, sobre a ZED -->
  <link name="camera_user_link"/>
  <joint name="camera_user_joint" type="fixed">
    <parent link="zed_mount"/>
    <child link="camera_user_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 3.14159"/>
  </joint>

</robot>