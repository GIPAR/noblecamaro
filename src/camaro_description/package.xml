<?xml-model href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
<name>camaro_description</name>
<version>1.0.0</version>
<description>Descrição do robô Camaro para simulação no ROS2</description>
<maintainer email="camaro@gipar.com">camaro</maintainer>
<license>Apache-2.0</license>
<buildtool_depend>ament_cmake</buildtool_depend>
<!--  ── Dependências existentes (não alteradas) ──  -->
<depend>rclpy</depend>
<depend>tf2_msgs</depend>
<depend>ros_gz_bridge</depend>
<depend>ros_gz_sim</depend>
<!--  ── Novas dependências C++ — Camadas 1 e 2 ──  -->
<depend>rclcpp</depend>
<depend>rclcpp_lifecycle</depend>
<depend>geometry_msgs</depend>
<depend>sensor_msgs</depend>
<depend>nav2_core</depend>
<depend>nav2_behaviors</depend>
<depend>nav2_util</depend>
<depend>nav2_msgs</depend>
<depend>pluginlib</depend>
<depend>tf2</depend>
<depend>tf2_ros</depend>
<!--  ── Exec depends existentes (não alterados) ──  -->
<exec_depend>robot_state_publisher</exec_depend>
<exec_depend>joint_state_publisher</exec_depend>
<exec_depend>joint_state_publisher_gui</exec_depend>
<exec_depend>xacro</exec_depend>
<exec_depend>gz_ros2_control</exec_depend>
<exec_depend>ros2_controllers</exec_depend>
<export>
<build_type>ament_cmake</build_type>
<!--  Registra o plugin de recovery pro Nav2  -->
<pluginlib plugin_description_file="plugins/camaro_recovery_plugin.xml"/>
</export>
</package>