    <model name='home_base'>
      <static>true</static>
      <link name='link'>
        <visual name='disk'>
          <pose>-4.0 0 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.75 0.2 1</ambient>
            <diffuse>0.05 0.85 0.25 1</diffuse>
            <emissive>0.02 0.3 0.08 1</emissive>
          </material>
        </visual>
        <visual name='ring'>
          <!-- rebaixados abaixo do LiDAR (z=0.06): verde 0.00..0.04 e
               branco 0.00..0.03. O verde (r 0.6) cobre o miolo e sobra a
               borda branca (r 0.75) visivel de 0.6 a 0.75. -->
          <pose>-4.0 0 0.015 0 0 0</pose>
          <geometry><cylinder><radius>0.75</radius><length>0.03</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

