<?xml version="1.0" ?>
<!--
  Gazebo Ackermann steering plugin demo

  Try sending commands:

    gz topic -t "/model/vehicle_blue/cmd_vel" -m gz.msgs.Twist -p "linear: {x: 0.5}, angular: {z: 0.1}"

  Listen to odometry:

    gz topic -e -t /model/vehicle_blue/odometry

-->
<sdf version="1.6">
  <world name="ackermann_steering">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
              </ode>
              <bullet>
                <friction>1</friction>
                <rolling_friction>0.1</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  
  <model name="robot">
    <!-- Chassi do robô -->
    <link name="base_link">
        <visual>
            <origin rpy="1.5707 0 0" xyz="-0.02 0.155 -0.05"/>
            <geometry>
                <box size="0.55 1.0 0.3"/>
                <!-- <mesh filename="file:///home/camaro/camaro_sim_ws/install/camaro_description/share/camaro_description/meshes/chassi.obj" scale="0.70 1 1.2" /> -->
            </geometry>
        </visual>

        <collision>
            <origin rpy="0 0 -1.5708" xyz="0 0 0.2"/>
            <geometry>
                <box size="0.55 1.0 0.3"/>
            </geometry>
        </collision> 

        <inertial>
            <mass value="10"/>
            <inertia ixx="0.9091" ixy="0.0" ixz="0.0" iyy="0.3271" iyz="0.0" izz="1.0854"/>
        </inertial>
    </link>



    <!-- Roda dianteira direita -->
    <link name="right_front_wheel">

        <visual>
            <geometry>
                
                <cylinder length="0.1" radius="0.13"/>
                
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
            
        </visual>

        <collision>
            <geometry>

                <cylinder length="0.1" radius="0.13"/>
            </geometry>
        </collision> 

        <inertial>
            <mass value="1"/>
            <inertia ixx="0.00506" ixy="0.0" ixz="0.0" iyy="0.00506" iyz="0.0" izz="0.00845"/>
        </inertial>

    </link>

    <!-- Roda dianteira esquerda -->
   <link name="left_front_wheel">

        <visual>
            <geometry>
                
                <cylinder length="0.1" radius="0.13"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                
                <cylinder length="0.1" radius="0.13"/>
            </geometry>
        </collision> 

        <inertial>
            <mass value="1"/>
            <inertia ixx="0.005058" ixy="0.0" ixz="0.0" iyy="0.005058" iyz="0.0" izz="0.00845"/>
        </inertial>

    </link>


    <!-- Roda traseira direita -->
    <link name="right_rear_wheel">

        <visual>
            <geometry>
                
                <cylinder length="0.1" radius="0.13"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                
                <cylinder length="0.1" radius="0.13"/>
            </geometry>
        </collision> 

        <inertial>
            <mass value="1"/>
            <inertia ixx="0.005058" ixy="0.0" ixz="0.0" iyy="0.005058" iyz="0.0" izz="0.00845"/>
        </inertial>

    </link>

    <!-- Roda traseira esquerda -->
    <link name="left_rear_wheel">

        <visual>
            <geometry>
                
                <cylinder length="0.1" radius="0.13"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.13"/>
            </geometry>
        </collision> 

        <inertial>
            <mass value="1"/>
            <inertia ixx="0.005058" ixy="0.0" ixz="0.0" iyy="0.005058" iyz="0.0" izz="0.00845"/>
        </inertial>

    </link>

    <!-- Link de direção direita -->
<link name="steering_right">
    <visual>
        <geometry>
            <box size="0.05 0.05 0.05"/> <!-- Geometria do visual -->
        </geometry>
        <material name="gray">
            <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
    </visual>
    
    <collision>
        <geometry>
            <box size="0.05 0.05 0.05"/> <!-- Geometria da colisão -->
        </geometry>
    </collision>
    
    <inertial>
        <mass value="0.1"/> <!-- Definir massa -->
        <inertia ixx="4.16667e-5" ixy="0.0" ixz="0.0" iyy="4.16667e-5" iyz="0.0" izz="4.16667e-5"/>
    </inertial>
</link>

<!-- Link de direção esquerda -->
<link name="steering_left">
    <visual>
        <geometry>
            <box size="0.05 0.05 0.05"/> <!-- Geometria do visual -->
        </geometry>
        <material name="gray">
            <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
    </visual>
    
    <collision>
        <geometry>
            <box size="0.05 0.05 0.05"/> <!-- Geometria da colisão -->
        </geometry>
        
    </collision>
    
    <inertial>
        <mass value="0.1"/> <!-- Definir massa -->
        <inertia ixx="4.16667e-5" ixy="0.0" ixz="0.0" iyy="4.16667e-5" iyz="0.0" izz="4.16667e-5"/>
    </inertial>
</link>
<link name="lidarA">
    <visual>
        <geometry>
            <cylinder radius="0.05" length="0.02"/>
        </geometry>

        <material name="gray">
            <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
    </visual>

    <collision>
         <geometry>
            <cylinder radius="0.05" length="0.02"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="0.1"/> 
        <inertia ixx="6.583e-05" ixy="0.0" ixz="0.0" iyy="6.583e-05" iyz="0.0" izz="0.000125"/>
    </inertial>
</link>

    <!--Junta do Lidar ao chassi-->
    <joint name="lidar_to_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidarA"/>
        <origin rpy="3.141519 3.141519 -0.750" xyz="0.4 -0.06 -0.05"/>
    </joint>
    <!-- Joints para controle de direção das rodas dianteiras -->
    <joint name="right_front_steering_joint" type="revolute">
        <parent link="base_link"/>
        <child link="steering_right"/>
        <origin rpy="0 -1.57079 -1.5708" xyz="0.3 -0.33 0.08"/>
        <axis xyz="1 0 0"/> <!-- Eixo de rotação vertical para controle da direção -->
        <limit lower="-0.46373" upper="0.46373" effort="100" velocity="1.0"/>
    </joint>

    <joint name="left_front_steering_joint" type="revolute">
        <parent link="base_link"/>
        <child link="steering_left"/>
        <origin rpy="0 -1.57079 -1.5708" xyz="0.3 0.33 0.08"/>
        <axis xyz="1 0 0"/> <!-- Eixo de rotação vertical para controle da direção -->
        <limit lower="-0.46373" upper="0.46373" effort="100" velocity="1.0"/>
    </joint>

    <!-- Joints para permitir a rotação das rodas enquanto o robô se move -->
    <joint name="right_rear_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_rear_wheel"/>
        <origin rpy="0 1.57079 1.5708" xyz="-0.3 -0.33 0.08"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.1" friction="0.2"/>
    </joint>
    <joint name="left_rear_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_rear_wheel"/>
        <origin rpy="0 -1.57079 -1.5708" xyz="-0.3 0.33 0.08"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.1" friction="0.2"/>
    </joint>

    <!-- Joints para as rodas dianteiras girarem para movimento para frente e para trás -->
    <joint name="right_front_wheel_joint" type="continuous">
        <parent link="steering_right"/>
        <child link="right_front_wheel"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/> <!-- Eixo de rotação para movimento para frente e para trás -->
    </joint>

    <joint name="left_front_wheel_joint" type="continuous">
        <parent link="steering_left"/>
        <child link="left_front_wheel"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/> <!-- Eixo de rotação para movimento para frente e para trás -->
    </joint>

     <!--Link fictício-->
    <link name="dummy_link"/>
    <joint name="dummy_joint" type="fixed">
        <parent link="dummy_link"/>
        <child link="base_link"/>
    </joint>

    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
            <robotNamespace>/</robotNamespace>
        </plugin>
    </gazebo>
    

<!-- Transmissões para controle da direção (steering) das rodas dianteiras -->
    <transmission name="right_front_steering_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="right_front_steering_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="right_front_steering_actuator">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="left_front_steering_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="left_front_steering_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="left_front_steering_actuator">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <!-- Transmissões para controle da rotação das rodas (movimento para frente e para trás) -->
    <transmission name="right_front_wheel_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="right_front_wheel_joint">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="right_front_wheel_actuator">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="left_front_wheel_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="left_front_wheel_joint">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="left_front_wheel_actuator">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="right_rear_wheel_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="right_rear_wheel_joint">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="right_rear_wheel_actuator">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="left_rear_wheel_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="left_rear_wheel_joint">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="left_rear_wheel_actuator">
            <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <gazebo reference="lidarA">
        <sensor type="ray" name="lidar">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>50</update_rate>
        <ray>
            <scan>
            <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592</min_angle>
                <max_angle>0</max_angle>
            </horizontal>
            </scan>
            <range>
            <min>0.10</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
            </range>
            <noise>
            <type>gaussian</type>
            <!-- Noise parameters based on published spec for Hokuyo laser
                achieving "+-30mm" accuracy at range < 10m.  A mean of 0.0m and
                stddev of 0.01m will put 99.7% of samples within 0.03m of the true
                reading. -->
            <mean>0.0</mean>
            <stddev>0.01</stddev>
            </noise>
        </ray>
        <plugin name="gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_laser.so">
            <topicName>/scan</topicName>
            <frameName>lidarA</frameName>
        </plugin>
        </sensor>
  </gazebo>
</model>

  </world>
</sdf>
